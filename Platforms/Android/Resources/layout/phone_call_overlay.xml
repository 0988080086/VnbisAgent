<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

	<!-- 1. HEADER: THÔNG TIN CUỘC GỌI -->
	<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="8dp">

		<TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THÔNG TIN CUỘC GỌI"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#555555" />

		<TextView
            android:id="@+id/lblPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0988080086"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#007ACC"
            android:layout_marginTop="4dp" />
	</LinearLayout>

	<View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="8dp" />

	<!-- 2. DANH SÁCH 2 CỘT DỰA TRÊN DATATABLE -->
	<ListView
        android:id="@+id/lstInfo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#F0F0F0"
        android:dividerHeight="1dp"
        android:scrollbars="vertical"
        android:nestedScrollingEnabled="true" />
	<!-- [SỬA TẠI ĐÂY]: Thêm nestedScrollingEnabled để tránh ListView bị ẩn khi C# đặt WrapContent -->

	<View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

	<!-- 3. CỤM NÚT BẤM CỐ ĐỊNH Ở ĐÁY (4 NÚT) -->
	<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

		<!-- 1. Nút Nghe Máy (Xanh lá) -->
		<androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAnswer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:minHeight="48dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="Nghe&#10;máy"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:backgroundTint="#28A745"
            app:insetTop="0dp"
            app:insetBottom="0dp" />
		<!-- [SỬA TẠI ĐÂY]: Đổi android:insetTop -> app:insetTop (và Bottom) để triệt tiêu viền ẩn nút -->

		<!-- 2. Nút Từ Chối (Đỏ) -->
		<androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnReject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:minHeight="48dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="Từ&#10;chối"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:backgroundTint="#DC3545"
            app:insetTop="0dp"
            app:insetBottom="0dp" />
		<!-- [SỬA TẠI ĐÂY]: Đổi android:insetTop -> app:insetTop (và Bottom) -->

		<!-- 3. Nút Chia Sẻ (Xanh dương Zalo/Share) -->
		<androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:minHeight="48dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="Chia&#10;sẻ"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0088CC"
            app:insetTop="0dp"
            app:insetBottom="0dp" />
		<!-- [SỬA TẠI ĐÂY]: Đổi android:insetTop -> app:insetTop (và Bottom) -->

		<!-- 4. Nút Thoát (Xám đậm / Đỏ nhạt) -->
		<androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnClose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:minHeight="48dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="Thoát"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6C757D"
            app:insetTop="0dp"
            app:insetBottom="0dp" />
		<!-- [SỬA TẠI ĐÂY]: Đổi android:insetTop -> app:insetTop (và Bottom) -->
	</LinearLayout>

</LinearLayout>