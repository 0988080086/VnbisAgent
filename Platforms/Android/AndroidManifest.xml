<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />

	<!-- Quyền đọc thông tin cuộc gọi -->
	<uses-permission android:name="android.permission.READ_PHONE_STATE" />
	<uses-permission android:name="android.permission.READ_CALL_LOG" />

	<!-- Quyền đọc nhấn nghe và huỷ cuộc gọi -->
	<uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
	<uses-permission android:name="android.permission.CALL_PHONE" />
	
	<!-- Nhận số gọi đi -->
	<uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS" />
	<!-- Phục vụ tránh báo lỗi liên quan tới Call Screening-->
	<uses-permission android:name="android.permission.READ_CONTACTS" />
	<!-- Call Screening -->
	<uses-permission android:name="android.permission.MANAGE_OWN_CALLS"/>

	<!-- Pin -->
	<uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

	<!-- Overlay -->
	<uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

	<!-- Foreground -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>

	<application
        android:allowBackup="true"
        android:icon="@mipmap/appicon"
        android:roundIcon="@mipmap/appicon_round"
        android:supportsRtl="true">

		<!-- AgentService -->
		<service
            android:name=".Platforms.Android.AgentService"
            android:foregroundServiceType="phoneCall"
            android:enabled="true"
            android:exported="false" />

		<!-- Call Screening -->
		<service
            android:name="vnbisagent.platforms.android.CallScreeningEx"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:enabled="true"
            android:exported="true">

			<intent-filter>
				<action android:name="android.telecom.CallScreeningService"/>
			</intent-filter>

			<meta-data
                android:name="android.telecom.CallScreeningService"
                android:value="true"/>

		</service>

	</application>

</manifest>